{
  "_comment": "What foundation.mjs writes. A module is on unless it names enabled_by (an answer that must be true). A file with `only` needs that variable true; `unless` skips it when true. `exec` marks scripts executable. `merge: gitignore` appends missing lines to an existing .gitignore instead of skipping it.",
  "modules": {
    "agent-instructions": {
      "summary": "One AGENTS.md that every agent reads, with thin adapters for Claude Code, Gemini CLI and GitHub Copilot",
      "files": [
        {
          "src": "agents/AGENTS.md.tmpl",
          "dest": "AGENTS.md"
        },
        {
          "src": "agents/CLAUDE.md.tmpl",
          "dest": "CLAUDE.md"
        },
        {
          "src": "agents/GEMINI.md.tmpl",
          "dest": "GEMINI.md"
        },
        {
          "src": "agents/copilot-instructions.md.tmpl",
          "dest": ".github/copilot-instructions.md"
        },
        {
          "src": "agents/tests.instructions.md.tmpl",
          "dest": ".github/instructions/tests.instructions.md"
        },
        {
          "src": "agents/docs.instructions.md.tmpl",
          "dest": ".github/instructions/docs.instructions.md"
        },
        {
          "src": "agents/component-AGENTS.md.tmpl",
          "dest": "@@component_path@@/AGENTS.md",
          "for_each": "component",
          "only": "monorepo"
        },
        {
          "src": "agents/CLAUDE.md.tmpl",
          "dest": "@@component_path@@/CLAUDE.md",
          "for_each": "component",
          "only": "monorepo"
        },
        {
          "src": "agents/GEMINI.md.tmpl",
          "dest": "@@component_path@@/GEMINI.md",
          "for_each": "component",
          "only": "monorepo"
        },
        {
          "src": "agents/component.instructions.md.tmpl",
          "dest": ".github/instructions/@@component_name@@.instructions.md",
          "for_each": "component",
          "only": "monorepo"
        }
      ]
    },
