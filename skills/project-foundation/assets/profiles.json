{
  "_comment": "Language profiles. The skill fills the answers; a profile supplies the commands and tool names the templates need. A value in the answers file overrides the profile's. Commands are conventions of each ecosystem: check they exist in the project (a Maven project without spotless has no spotless:check) and edit the answers before running bootstrap.py. precommit_cmd is empty everywhere on purpose: a pre-commit hook that calls a tool the project has not installed would break the first commit. Set it in the answers once the project has a fast staged-files check (for Node: npx lint-staged, with lint-staged installed). nix_packages are nixpkgs attribute names for the optional dev shell (flake.nix); check them against the nixpkgs you pin.",
  "defaults": {
    "default_branch": "main",
    "license": "MIT",
    "release_please": true,
    "codeql": true,
    "dependabot": true,
    "spec_driven": false,
    "no_attribution": true,
    "header_max": 100,
    "body_max": 120,
    "setup_cmd": "",
    "build_cmd": "",
    "lint_cmd": "",
    "format_cmd": "",
    "format_check_cmd": "",
    "test_cmd": "",
    "quality_cmd": "",
    "precommit_cmd": "",
    "src_dir": "src",
    "test_dir": "test",
    "code_extensions": ".ts",
    "test_globs": "test/**",
    "source_globs": "src/**",
    "gitignore_extra": ".env\n.idea/\n.vscode/\n*.log",
    "indent_size": "2",
    "ci_timeout": "20",
    "scopes_example": "api, cli, core, docs, deps, release",
    "nix": false,
    "nix_packages": "",
    "agent_opens_prs": true
  },
  "profiles": {
    "node": {
      "family": "node",
      "tool": "npm",
      "label": "Node.js / TypeScript",
      "runtime_version": "24",
      "setup_cmd": "npm install",
      "build_cmd": "npm run build",
      "lint_cmd": "npm run lint",
      "format_cmd": "npm run format",
      "format_check_cmd": "npm run format:check",
      "test_cmd": "npm test",
      "quality_cmd": "npm run quality",
      "precommit_cmd": "",
      "dependabot_ecosystem": "npm",
      "codeql_language": "javascript-typescript",
      "release_type": "node",
      "src_dir": "src",
      "test_dir": "test",
      "code_extensions": ".ts",
      "test_globs": "test/**,**/*.test.ts,**/*.test.js,**/*.spec.ts",
      "source_globs": "src/**",
      "gitignore_extra": "node_modules\ndist\ncoverage\n.env\n.idea/\n.vscode/\n*.log",
      "indent_size": "2",
      "nix_packages": "nodejs_24"
    },
    "java-maven": {
      "family": "java",
      "tool": "maven",
      "label": "Java (Maven)",
      "runtime_version": "21",
      "setup_cmd": "./mvnw -B -DskipTests install",
      "build_cmd": "./mvnw -B -DskipTests package",
      "lint_cmd": "./mvnw -B checkstyle:check",
      "format_cmd": "./mvnw -B spotless:apply",
      "format_check_cmd": "./mvnw -B spotless:check",
      "test_cmd": "./mvnw -B test",
      "quality_cmd": "./mvnw -B verify",
      "dependabot_ecosystem": "maven",
      "codeql_language": "java-kotlin",
      "release_type": "maven",
      "src_dir": "src/main",
      "test_dir": "src/test",
      "code_extensions": ".java",
      "test_globs": "src/test/**,**/*Test.java,**/*IT.java",
      "source_globs": "src/main/**",
      "gitignore_extra": "target/\n.idea/\n*.iml\n.vscode/\n.env\n*.log",
      "indent_size": "4",
      "nix_packages": "jdk21 maven"
    },
    "java-gradle": {
      "family": "java",
      "tool": "gradle",
      "label": "Java / Kotlin (Gradle)",
      "runtime_version": "21",
      "setup_cmd": "./gradlew build -x test",
      "build_cmd": "./gradlew assemble",
      "lint_cmd": "./gradlew check -x test",
      "format_cmd": "./gradlew spotlessApply",
      "format_check_cmd": "./gradlew spotlessCheck",
      "test_cmd": "./gradlew test",
      "quality_cmd": "./gradlew check",
      "dependabot_ecosystem": "gradle",
      "codeql_language": "java-kotlin",
      "release_type": "simple",
      "src_dir": "src/main",
      "test_dir": "src/test",
      "code_extensions": ".java",
      "test_globs": "src/test/**,**/*Test.java,**/*Test.kt",
      "source_globs": "src/main/**",
      "gitignore_extra": "build/\n.gradle/\n.idea/\n*.iml\n.vscode/\n.env\n*.log",
      "indent_size": "4",
      "nix_packages": "jdk21 gradle"
    },
    "rust": {
      "family": "rust",
      "tool": "cargo",
      "label": "Rust",
      "runtime_version": "stable",
      "setup_cmd": "cargo fetch",
      "build_cmd": "cargo build --locked",
      "lint_cmd": "cargo clippy --all-targets --all-features -- -D warnings",
      "format_cmd": "cargo fmt --all",
      "format_check_cmd": "cargo fmt --all -- --check",
      "test_cmd": "cargo test --locked --all-features",
      "quality_cmd": "cargo fmt --all -- --check && cargo clippy --all-targets --all-features -- -D warnings && cargo test --locked --all-features",
      "dependabot_ecosystem": "cargo",
      "codeql_language": "rust",
      "release_type": "rust",
      "src_dir": "src",
      "test_dir": "tests",
      "code_extensions": ".rs",
      "test_globs": "tests/**",
      "source_globs": "src/**",
      "gitignore_extra": "target/\n.env\n.idea/\n.vscode/\n*.log",
      "indent_size": "4",
      "nix_packages": "rustc cargo clippy rustfmt rust-analyzer"
    },
    "python": {
      "family": "python",
      "tool": "pip",
      "label": "Python",
      "runtime_version": "3.13",
      "setup_cmd": "python -m pip install -e \".[dev]\"",
      "build_cmd": "python -m build",
      "lint_cmd": "ruff check .",
      "format_cmd": "ruff format .",
      "format_check_cmd": "ruff format --check .",
      "test_cmd": "pytest",
      "quality_cmd": "ruff check . && ruff format --check . && pytest",
      "dependabot_ecosystem": "pip",
      "codeql_language": "python",
      "release_type": "python",
      "src_dir": "src",
      "test_dir": "tests",
      "code_extensions": ".py",
      "test_globs": "tests/**,**/test_*.py,**/*_test.py",
      "source_globs": "src/**",
      "gitignore_extra": "__pycache__/\n*.pyc\n.venv/\ndist/\n*.egg-info/\n.pytest_cache/\n.ruff_cache/\n.env\n.idea/\n.vscode/",
      "indent_size": "4",
      "nix_packages": "python313 ruff uv"
    },
    "go": {
      "family": "go",
      "tool": "go",
      "label": "Go",
      "runtime_version": "stable",
      "setup_cmd": "go mod download",
      "build_cmd": "go build ./...",
      "lint_cmd": "go vet ./...",
      "format_cmd": "gofmt -w .",
      "format_check_cmd": "test -z \"$(gofmt -l .)\"",
      "test_cmd": "go test ./...",
      "quality_cmd": "test -z \"$(gofmt -l .)\" && go vet ./... && go test ./...",
      "dependabot_ecosystem": "gomod",
      "codeql_language": "go",
      "release_type": "go",
      "src_dir": ".",
      "test_dir": ".",
      "code_extensions": ".go",
      "test_globs": "**/*_test.go",
      "source_globs": "**/*.go",
      "gitignore_extra": "bin/\n*.test\n*.out\n.env\n.idea/\n.vscode/",
      "indent_size": "4",
      "nix_packages": "go golangci-lint"
    },
    "other": {
      "family": "other",
      "tool": "none",
      "label": "Other",
      "runtime_version": "",
      "dependabot_ecosystem": "",
      "codeql_language": "",
      "release_type": "simple",
      "codeql": false,
      "gitignore_extra": ".env\n.idea/\n.vscode/\n*.log",
      "nix_packages": ""
    }
  }
}
