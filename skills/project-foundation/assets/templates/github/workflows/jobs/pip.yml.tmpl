  quality-@@component_name@@:
    name: @@component_name@@ (@@label@@)
    runs-on: ubuntu-latest
    timeout-minutes: @@ci_timeout@@
@@#if monorepo@@    needs: changes
    if: needs.changes.outputs.@@component_key@@ == 'true'
@@/if@@    defaults:
      run:
        working-directory: @@component_path@@
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-python@v6
        with:
          python-version-file: "@@component_prefix@@.python-version"
      - run: @@setup_cmd@@
      - name: Quality gate
        run: @@quality_cmd@@
