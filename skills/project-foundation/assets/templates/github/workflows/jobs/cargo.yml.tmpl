  quality-@@component_name@@:
    name: @@component_name@@ (@@label@@)
    runs-on: ubuntu-latest
    timeout-minutes: @@ci_timeout@@
@@#if monorepo@@    needs: changes
    if: needs.changes.outputs.@@component_key@@ == 'true'
@@/if@@    defaults:
      run:
        working-directory: @@component_path@@
    steps:
      - uses: actions/checkout@v7
      # Reads rust-toolchain.toml of the component, so the pin and CI cannot drift; caches the build.
      - uses: actions-rust-lang/setup-rust-toolchain@v1
        with:
          components: rustfmt, clippy
          cache-workspaces: "@@component_path@@"
          # The gate decides what is an error (clippy -D warnings); do not turn every compiler warning into one as well.
          rustflags: ""
      - name: Quality gate
        run: @@quality_cmd@@
