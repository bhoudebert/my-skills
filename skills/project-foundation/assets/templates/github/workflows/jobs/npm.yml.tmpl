  quality-@@component_name@@:
    name: @@component_name@@ (@@label@@)
    runs-on: ubuntu-latest
    timeout-minutes: @@ci_timeout@@
@@#if monorepo@@    needs: changes
    if: needs.changes.outputs.@@component_key@@ == 'true'
@@/if@@    defaults:
      run:
        working-directory: @@component_path@@
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v7
        with:
          node-version-file: @@component_prefix@@.nvmrc
          cache: npm
          cache-dependency-path: @@component_prefix@@package-lock.json
      - run: npm ci --ignore-scripts
      - name: Quality gate
        run: @@quality_cmd@@
