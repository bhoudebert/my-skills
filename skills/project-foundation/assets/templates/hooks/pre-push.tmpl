#!/bin/sh
# The quality gate before a push, so a red pull request is a surprise less often.
# Skip once with SKIP_PRE_PUSH=1 git push, or git push --no-verify: the pull request checks run anyway.
[ -n "$SKIP_PRE_PUSH" ] && { echo "pre-push skipped (SKIP_PRE_PUSH is set)" >&2; exit 0; }
cd "$(git rev-parse --show-toplevel)" || exit 1
@@#if spec_driven@@
# The spec review (deterministic checks; a local model too when SPEC_REVIEW_MODEL is set). It never blocks on its own failure.
if command -v node >/dev/null 2>&1; then
  node --env-file-if-exists=.env scripts/spec-review.ts --hook || exit 1
else
  echo "spec review skipped: node is not installed" >&2
fi
@@/if@@
echo "pre-push: @@hook_quality_cmd@@" >&2
@@hook_quality_cmd@@
status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-push: the quality gate failed. Fix it, or define it first if the project does not have one yet (AGENTS.md, 'Useful commands')." >&2
  echo "          Skip once with SKIP_PRE_PUSH=1 git push; the pull request checks run anyway." >&2
  exit "$status"
fi
